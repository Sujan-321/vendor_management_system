```gitignore
# ==========================================
# Django
# ==========================================
*.log
*.pot
*.py[cod]
__pycache__/

# Database
db.sqlite3

# User uploaded files
media/

# Local sensitive files
password.txt
.env
staticfiles/
# ==========================================
# Django Migrations
# ==========================================
# Keep migration files in Git.
# Ignore only migration cache.
**/migrations/__pycache__/

# ==========================================
# Python Virtual Environments
# ==========================================
env/
venv/
ENV/
.venv/
env.bak/
venv.bak/

# ==========================================
# Build / Distribution
# ==========================================
.Python
build/
dist/
develop-eggs/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.whl
*.egg-info/
.installed.cfg
*.egg
*.manifest
*.spec

# ==========================================
# Testing / Coverage
# ==========================================
.coverage
.coverage.*
.cache/
.pytest_cache/
.tox/
htmlcov/
coverage.xml
nosetests.xml
*.cover
.hypothesis/
.mypy_cache/

# ==========================================
# Jupyter
# ==========================================
.ipynb_checkpoints/

# ==========================================
# PyCharm / IntelliJ
# ==========================================
.idea/
*.iws
out/

# ==========================================
# Visual Studio Code
# ==========================================
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# ==========================================
# History
# ==========================================
.history/

# ==========================================
# Miscellaneous
# ==========================================
*.bak
.python-version
celerybeat-schedule.*
*.sage.py
/site
sftp-config.json
```